# ===================================================
# TATADANA FINTECH SAAS — ENVIRONMENT VARIABLES
# ===================================================

# Application URL
APP_URL=http://localhost:3000
WEBHOOK_BASE_URL=https://tatadana.app

# Telegram Bot
# 1 Shared bot token for all users
TELEGRAM_BOT_TOKEN=7891234567:AAExampleTelegramBotTokenTataDana

# Multi-Provider AI Keys (also manageable from Admin Dashboard)
GEMINI_API_KEY=AIzaSyExampleGeminiKeyTataDanaProduction
OPENAI_API_KEY=sk-example-openai-key-tatadana
DEEPSEEK_API_KEY=sk-example-deepseek-key-tatadana
AI_ACTIVE_PROVIDER=gemini
AI_EXECUTION_MODE=single # 'single' or 'failover'

# Supabase (Postgres, Auth, Storage, Realtime)
NEXT_PUBLIC_SUPABASE_URL=https://tatadana-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.example_anon_key_tatadana
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.example_service_role_key_tatadana
SUPABASE_STORAGE_BUCKET=laporan-exports

# Midtrans Payment Gateway
MIDTRANS_SERVER_KEY=SB-Mid-server-ExampleKeyTataDana123
MIDTRANS_CLIENT_KEY=SB-Mid-client-ExampleKeyTataDana456
MIDTRANS_IS_PRODUCTION=false

# Timezone Default (WIB / Asia/Jakarta)
NEXT_PUBLIC_DEFAULT_TIMEZONE=Asia/Jakarta
